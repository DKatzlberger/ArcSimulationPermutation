process {
    executor      = 'slurm'
    errorStrategy = 'retry'
    maxRetries    = 2
    
    // Global fallback ========================================================
    cpus   = 1
    memory = { 16.GB * task.attempt }
    time   = { 1.h * task.attempt }

    // Process specific =======================================================
    withName: 'prepare' {
        cpus   = 4
        memory = { 128.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

executor {
    queueSize = 2000
}