process {
    executor      = 'slurm'
    errorStrategy = 'retry'
    maxRetries    = 0
    
    // Global fallback ========================================================
    cpus   = 1
    memory = { 32.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Process specific =======================================================
    withName: 'prepare' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'shuffle' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'pseudobulk' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'nebula' {
        cpus   = 1              
        memory = { 64.GB * task.attempt } 
        time   = { 12.h * task.attempt }
    }

    withName: 'scmageck' {
        cpus   = 1                      
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}